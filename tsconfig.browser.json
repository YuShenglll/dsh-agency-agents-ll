{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The client spec belongs to this project (see `include`), and it reaches
    // the shipped asset trees through the Host modules it imports, so the Node
    // globals and built-in module declarations have to be visible here.
    // Nothing the browser bundle itself carries touches them.
    "types": ["node"]
  },
  "include": ["src/client/**/*.ts"]
}
